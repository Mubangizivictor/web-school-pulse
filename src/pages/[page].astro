---
import BaseLayout from '../layouts/BaseLayout.astro';
import { plans, siteConfig } from '../config/site';
const pages=['solutions','pricing','why-school-pulse','about','demo','contact','subscribe','privacy','terms','login'];
export function getStaticPaths(){return pages.map(page=>({params:{page}}));}
const page=Astro.params.page!;
const money=(n:number|null)=>n===null?'Custom':`UGX ${n.toLocaleString('en-UG')}`;
const titles:Record<string,string>={solutions:'Solutions',pricing:'Pricing','why-school-pulse':'Why School Pulse',about:'About School Pulse',demo:'Book a Demo',contact:'Contact Us',subscribe:'Subscribe to School Pulse',privacy:'Privacy Policy',terms:'Terms of Service',login:'Open School Pulse'};
const title=titles[page]||'School Pulse';
---
<BaseLayout title={`${title} — School Pulse`}>
{page==='solutions' && <><section class="page-hero"><div class="container"><span class="eyebrow">Solutions</span><h1>One platform. Different school realities.</h1><p class="lead" style="margin-inline:auto">School Pulse adapts to institution type, structure, staff responsibilities and operational workflows.</p></div></section><section class="section"><div class="container grid">{['Day Schools','Boarding Schools','Primary Schools','Secondary Schools','Universities & Colleges','Multi-Campus Institutions','School Owners & Directors','International Schools'].map(x=><div class="card"><div class="icon">✓</div><h3>{x}</h3><p class="muted">Configure School Pulse around your institution without creating a separate product.</p></div>)}</div></section></>}
{page==='pricing' && <><section class="page-hero"><div class="container"><span class="eyebrow">Simple pricing</span><h1>Choose a plan that fits your school.</h1><p class="lead" style="margin-inline:auto">Termly pricing shown below. Public Firebase pricing can replace these safe defaults when connected.</p></div></section><section class="section"><div class="container"><div class="pricing">{plans.map(p=><div class:list={['card','price-card',p.recommended&&'recommended']}><span class="badge" style={p.recommended?'':'display:none'}>Recommended</span><h3>{p.name}</h3><div class="price">{money(p.price)}</div><p class="muted">{p.price?`per ${p.cycle.toLowerCase()}`:'Custom agreement'}</p><p>{p.range}</p><div class="feature-list">{['Student management','Attendance','Academics','Role-based access','Reporting'].map(x=><div class="feature-item"><span class="check">✓</span><span>{x}</span></div>)}</div><div class="cta-row"><a class="btn btn-primary" href={p.price?`/subscribe?plan=${p.name.toLowerCase()}`:'/contact'}>{p.price?'Choose Plan':'Contact Us'}</a></div></div>)}</div><p class="notice" style="margin-top:24px">Annual billing may be offered with a configured discount. Backend subscription entitlements remain authoritative.</p></div></section></>}
{page==='why-school-pulse' && <><section class="page-hero"><div class="container"><span class="eyebrow">Why School Pulse</span><h1>Less fragmentation. More operational visibility.</h1></div></section><section class="section"><div class="container grid">{[['One platform','Connect school operations instead of maintaining disconnected tools.'],['Role-based','Give users access based on responsibility and assigned permissions.'],['Mobile-first','Designed for staff who may work primarily from phones.'],['Offline-aware','Core workflows are designed with unreliable connectivity in mind.'],['Flexible structure','Support different school types and configurable academic structures.'],['Attendance flexibility','QR, manual and optional NFC-ready attendance workflows.'],['Reporting','Turn operational data into useful school reporting.'],['Security','Tenant-scoped data, permissions and audit visibility.']].map(([a,b])=><div class="card"><h3>{a}</h3><p class="muted">{b}</p></div>)}</div></section></>}
{page==='about' && <><section class="page-hero"><div class="container"><span class="eyebrow">Victorbee Technologies</span><h1>Building practical technology for modern school operations.</h1><p class="lead" style="margin-inline:auto">School Pulse is developed by Victorbee Technologies as a connected school management platform for institutions in Uganda and the wider African market.</p></div></section><section class="section"><div class="container split"><div><h2>Our product direction</h2><p class="lead">School Pulse focuses on simplifying everyday school work while respecting the different structures, roles and operating realities found across institutions.</p></div><div class="card"><span class="eyebrow">School Pulse</span><h3>{siteConfig.tagline}</h3><p class="muted">Students, staff, attendance, academics, finance, boarding, health, security, transport and administration — connected through one platform.</p></div></div></section></>}
{page==='demo' && <><section class="page-hero"><div class="container"><span class="eyebrow">See School Pulse</span><h1>Book a school demo.</h1><p class="lead" style="margin-inline:auto">Tell us a little about your school and Victorbee Technologies will contact you.</p></div></section><section class="section"><div class="container"><form class="form" data-public-form="demo"><div class="field"><label>School Name</label><input name="schoolName" required /></div><div class="field"><label>Your Name</label><input name="contactName" required /></div><div class="field"><label>Phone Number</label><input name="phone" inputmode="tel" placeholder="07XXXXXXXX or +2567XXXXXXXX" required /></div><div class="field"><label>Email <span class="muted">optional</span></label><input name="email" type="email" /></div><div class="field"><label>District</label><input name="district" required /></div><div class="field"><label>Approximate Number of Students</label><select name="studentCountRange" required><option value="">Select range</option><option>Up to 300</option><option>301–800</option><option>801–1,500</option><option>1,500+</option></select></div><div class="field"><label>Preferred Contact Method</label><select name="preferredContact"><option>Phone</option><option>WhatsApp</option><option>Email</option></select></div><div class="field"><label>Optional Message</label><textarea name="message"></textarea></div><button class="btn btn-primary" type="submit">Request Demo</button><p class="notice" data-form-status hidden></p></form></div></section></>}
{page==='contact' && <><section class="page-hero"><div class="container"><span class="eyebrow">Contact</span><h1>Talk to Victorbee Technologies.</h1><p class="lead" style="margin-inline:auto">Questions about School Pulse, onboarding or subscriptions? Contact us directly.</p></div></section><section class="section"><div class="container split"><div><div class="card"><h3>School Pulse</h3><p><strong>Phone / WhatsApp</strong><br/><a href={`https://wa.me/${siteConfig.whatsappNumber}`}>{siteConfig.phone}</a></p><p><strong>Email</strong><br/><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></p></div></div><form class="form" data-public-form="contact"><div class="field"><label>Your Name</label><input name="name" required /></div><div class="field"><label>Phone Number</label><input name="phone" required /></div><div class="field"><label>Email</label><input name="email" type="email" /></div><div class="field"><label>Message</label><textarea name="message" required></textarea></div><button class="btn btn-primary" type="submit">Send Message</button><p class="notice" data-form-status hidden></p></form></div></section></>}
{page==='subscribe' && <><section class="page-hero"><div class="container"><span class="eyebrow">Subscription checkout</span><h1>Start your School Pulse subscription.</h1><p class="lead" style="margin-inline:auto">Complete your school details. Payment processing will use Yo! Payments once production API credentials and verified callbacks are configured.</p></div></section><section class="section"><div class="container"><form class="form" data-checkout><div class="field"><label>Plan</label><select name="plan" required>{plans.filter(p=>p.price).map(p=><option value={p.name}>{p.name} — {money(p.price)} / Term</option>)}</select></div><div class="field"><label>School Name</label><input name="schoolName" required /></div><div class="field"><label>Contact Person</label><input name="contactName" required /></div><div class="field"><label>Phone Number</label><input name="phone" required /></div><div class="field"><label>Email <span class="muted">optional</span></label><input name="email" type="email" /></div><div class="field"><label>District <span class="muted">optional</span></label><input name="district" /></div><div class="field"><label>Student Count</label><input name="studentCount" type="number" min="1" required /></div><div class="field"><label>Billing Cycle</label><select name="billingCycle"><option value="term">Termly</option><option value="annual">Annual</option></select></div><div class="field"><label>Payment Method</label><select name="paymentMethod"><option value="yo-mobile-money">Mobile Money via Yo! Payments</option><option value="cash">Cash / Manual onboarding</option></select></div><button class="btn btn-primary" type="submit">Continue to Review</button><p class="notice">Online payment is intentionally disabled until Yo! Payments production API credentials, Cloud Function secrets and callback verification are configured. The browser will never store payment credentials.</p></form></div></section></>}
{page==='privacy' && <><section class="page-hero"><div class="container"><span class="eyebrow">Legal</span><h1>Privacy Policy</h1><p class="lead" style="margin-inline:auto">Structured draft requiring final legal review before production launch.</p></div></section><section class="section"><div class="container card"><h2>Information we handle</h2><p class="muted">The public website may collect demo requests, contact information and subscription onboarding details. The School Pulse application separately processes school-authorized account and institutional data.</p><h2>Use, security and retention</h2><p class="muted">Data should be used for service delivery, communication, support, security and legitimate operational purposes. Production retention periods and legal bases must be finalized through business/legal review.</p><h2>Contact</h2><p class="muted">Privacy questions: {siteConfig.email}</p></div></section></>}
{page==='terms' && <><section class="page-hero"><div class="container"><span class="eyebrow">Legal</span><h1>Terms of Service</h1><p class="lead" style="margin-inline:auto">Structured draft requiring final business and legal approval.</p></div></section><section class="section"><div class="container card"><h2>Service use</h2><p class="muted">School Pulse is a school operations platform provided by Victorbee Technologies. Authorized institutions and users are responsible for lawful use, account security and the accuracy of information they submit.</p><h2>Subscriptions and payments</h2><p class="muted">Subscription terms, billing periods, payment confirmation, suspension and termination rules must match the final commercial agreement and verified backend billing records.</p><h2>Availability, data and intellectual property</h2><p class="muted">Final clauses for service availability, acceptable use, data handling, intellectual property and liability require legal approval before launch.</p></div></section></>}
{page==='login' && <section class="page-hero"><div class="container"><span class="eyebrow">Existing customer</span><h1>Open School Pulse</h1><p class="lead" style="margin-inline:auto">School Pulse application access is separate from this public website.</p><div class="cta-row" style="justify-content:center"><a class="btn btn-primary" href={siteConfig.appUrl}>Open School Pulse →</a><a class="btn btn-secondary" href="/">Back Home</a></div></div></section>}
<script is:inline>
const normalizeUgPhone=(v)=>{const d=v.replace(/\D/g,'');if(/^0[7][0-9]{8}$/.test(d))return '256'+d.slice(1);if(/^2567[0-9]{8}$/.test(d))return d;return null};
document.querySelectorAll('[data-public-form]').forEach(form=>form.addEventListener('submit',e=>{e.preventDefault();const data=new FormData(form);const phone=normalizeUgPhone(String(data.get('phone')||''));const status=form.querySelector('[data-form-status]');status.hidden=false;if(!phone){status.textContent='Please enter a valid Ugandan mobile number.';return}status.textContent='Form UI is ready. Secure Firebase submission will activate when the Cloud Function endpoint is configured.';}));
document.querySelector('[data-checkout]')?.addEventListener('submit',e=>{e.preventDefault();alert('Checkout UI is ready. Yo! Payments remains disabled until secure backend credentials and callbacks are configured.');});
</script>
</BaseLayout>
