---
import '../styles/auth.css';
import '../styles/branding.css';
import PublicBrand from '../components/PublicBrand.astro';
import PulseMark from '../components/PulseMark.astro';
import faviconUrl from '../assets/brand/favicon-48.png?url';
import appleTouchIconUrl from '../assets/brand/apple-touch-icon.png?url';
import logoLightUrl from '../assets/brand/logo_horizontal_light.png?url';
import wordmarkLightUrl from '../assets/brand/wordmark_light.png?url';

const { title = 'School Pulse', asideTitle = 'Everything your school needs, in one place.', asideCopy = 'School Pulse connects every part of school administration — from enrolment to graduation — into one practical platform.' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex" />
  <meta name="theme-color" content="#ffffff" />
  <link rel="icon" type="image/png" href={faviconUrl} />
  <link rel="apple-touch-icon" href={appleTouchIconUrl} />
  <link rel="manifest" href="/manifest.webmanifest" />
  <title>{title}</title>
</head>
<body style={`--sp-auth-logo:url("${logoLightUrl}")`}>
  <div class="brand-splash brand-splash-light" id="authBrandSplash" aria-hidden="true">
    <div class="brand-splash-stack">
      <PulseMark tone="light" size="min(220px,48vw)" />
      <img class="brand-splash-wordmark" src={wordmarkLightUrl} alt="" decoding="async" />
    </div>
  </div>
  <div class="auth-shell">
    <aside class="auth-aside">
      <div class="auth-aside-inner">
        <PublicBrand tone="dark" class="auth-aside-brand-lockup" />
        <h1>{asideTitle}</h1>
        <p>{asideCopy}</p>
        <div class="auth-benefits">
          <div class="auth-benefit"><i>✓</i><span>Set up in a few guided steps</span></div>
          <div class="auth-benefit"><i>✓</i><span>Secure Firebase authentication</span></div>
          <div class="auth-benefit"><i>✓</i><span>Student, finance & academic tools</span></div>
          <div class="auth-benefit"><i>✓</i><span>Uganda-focused onboarding support</span></div>
        </div>
      </div>
    </aside>
    <main class="auth-main"><slot /></main>
  </div>

  <script src="/js/onboarding-enhancements.js" defer></script>
  <script is:inline>
    (() => {
      const splash = document.getElementById('authBrandSplash');
      if (!splash) return;
      try {
        if (sessionStorage.getItem('schoolPulseAuthSplashSeen') === '1') {
          splash.remove();
          return;
        }
      } catch (_) {}
      window.addEventListener('load', () => {
        window.setTimeout(() => {
          splash.classList.add('is-hidden');
          window.setTimeout(() => splash.remove(), 320);
          try { sessionStorage.setItem('schoolPulseAuthSplashSeen', '1'); } catch (_) {}
        }, 220);
      }, { once: true });
    })();
  </script>
</body>
</html>
