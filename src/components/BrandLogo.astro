---
// `dark` = artwork for dark backgrounds (white type), `light` = for light ones.
import logoDark from '../assets/brand/logo_horizontal_dark.png?url';
import logoLight from '../assets/brand/logo_horizontal_light.png?url';
import iconDark from '../assets/brand/logo_mark_dark.png?url';
import iconLight from '../assets/brand/logo_mark_light.png?url';

interface Props {
  kind?: 'logo' | 'icon';
  mode?: 'dark' | 'light' | 'auto';
  alt?: string;
  class?: string;
  loading?: 'eager' | 'lazy';
}

const {
  kind = 'logo',
  mode = 'auto',
  alt = kind === 'icon' ? 'School Pulse' : 'School Pulse',
  class: className = '',
  loading = 'eager',
} = Astro.props;

const darkSrc = kind === 'icon' ? iconDark : logoDark;
const lightSrc = kind === 'icon' ? iconLight : logoLight;
const fixedSrc = mode === 'dark' ? darkSrc : lightSrc;
---
{mode === 'auto' ? (
  <picture class:list={['sp-brand-picture', className]}>
    <source media="(prefers-color-scheme: dark)" srcset={darkSrc} />
    <img class="sp-brand-image" src={lightSrc} alt={alt} loading={loading} decoding="async" />
  </picture>
) : (
  <img class:list={['sp-brand-image', className]} src={fixedSrc} alt={alt} loading={loading} decoding="async" />
)}
