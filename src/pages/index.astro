---
import BaseLayout from '../layouts/BaseLayout.astro';
import { modules, plans, siteConfig } from '../config/site';
const money=(n:number|null)=>n===null?'Custom':`UGX ${n.toLocaleString('en-UG')}`;
---
<BaseLayout title="School Pulse — Run Your Entire School From One Platform">
  <section class="hero"><div class="container hero-grid">
    <div><span class="eyebrow">School Management, Simplified</span><h1>Run Your Entire School From One Platform.</h1><p class="lead">School Pulse brings students, attendance, academics, finance, boarding, health, communication, security, transport and school operations into one secure platform built for modern African schools.</p><div class="cta-row"><a class="btn btn-primary" href="/demo">Book a Demo →</a><a class="btn btn-secondary" href="/features">Explore Features</a><a class="btn" href={siteConfig.appUrl}>Open School Pulse</a></div></div>
    <div class="mockup" aria-label="School Pulse dashboard preview placeholder"><div class="mock-top"><span class="dot"></span><span class="dot"></span><span class="dot"></span></div><div class="dashboard"><aside class="side"><div class="side-line"></div><div class="side-line"></div><div class="side-line"></div><div class="side-line"></div><div class="side-line"></div></aside><div class="content"><div class="stat-grid"><div class="stat"><small class="muted">Students</small><strong>1,284</strong></div><div class="stat"><small class="muted">Attendance</small><strong>94%</strong></div><div class="stat"><small class="muted">Active Staff</small><strong>64</strong></div></div><div class="charts"><div class="chart"><span class="eyebrow">Weekly attendance</span><div class="chart-line" style="margin-top:30px;width:85%"></div><div class="chart-line" style="width:65%"></div><div class="chart-line" style="width:92%"></div><div class="chart-line" style="width:74%"></div></div><div class="chart"><span class="eyebrow">Operations</span><div class="chart-line" style="margin-top:30px"></div><div class="chart-line" style="width:72%"></div><div class="chart-line" style="width:88%"></div></div></div></div></div></div>
  </div></section>
  <div class="trust"><div class="container">Built for African schools · Mobile-first · Offline-aware · Multi-role · Secure · Cloud-connected</div></div>
  <section class="section"><div class="container"><div class="section-head"><span class="eyebrow">What we offer</span><h2>Everything Your School Needs</h2><p>Connected tools for the people who run, teach, support and manage your institution.</p></div><div class="grid">{modules.slice(0,12).map(([name,desc],i)=><a class="card" href="/features"><div class="icon">{String(i+1).padStart(2,'0')}</div><h3>{name}</h3><p class="muted">{desc}</p><span class="eyebrow">Learn more →</span></a>)}</div></div></section>
  <section class="section alt"><div class="container split"><div><span class="eyebrow">Built for real operations</span><h2>Designed for how schools actually work.</h2><p class="lead">Mobile-first workflows, low-data considerations, configurable structures and role-based access help School Pulse adapt to different institutions without forcing one rigid model.</p><div class="feature-list">{['Day and boarding school workflows','Multiple staff roles on one account','QR and manual attendance with NFC-ready options','Term-based and configurable academic structures','Simple gate and security workflows'].map(x=><div class="feature-item"><span class="check">✓</span><span>{x}</span></div>)}</div></div><div class="card"><span class="eyebrow">Role-based workspace</span><h3>One account. The right tools for each responsibility.</h3><p class="muted">A teacher can also be a class teacher, subject teacher, patron, coach or administrator. School Pulse presents the correct workspace according to assigned permissions.</p><div class="grid" style="grid-template-columns:repeat(2,1fr);margin-top:20px">{['Admin','Teacher','Bursar','Nurse','Security','Director'].map(x=><div class="card" style="padding:14px">{x}</div>)}</div></div></div></section>
  <section class="section"><div class="container"><div class="section-head"><span class="eyebrow">Pricing</span><h2>Clear plans for growing schools</h2><p>Start termly. Annual billing can be offered with configured savings.</p></div><div class="pricing">{plans.map(p=><div class:list={['card','price-card',p.recommended&&'recommended']}><span class="badge" style={p.recommended?'':'display:none'}>Recommended</span><h3>{p.name}</h3><div class="price">{money(p.price)}</div><p class="muted">{p.price?`per ${p.cycle.toLowerCase()}`:'Talk to us'}</p><p>{p.range}</p><a class="btn btn-primary" href={p.price?'/subscribe':'/contact'}>{p.price?'Choose Plan':'Contact Us'}</a></div>)}</div><div class="cta-row" style="justify-content:center"><a class="btn btn-secondary" href="/pricing">Compare plans</a></div></div></section>
  <section class="section alt"><div class="container section-head"><span class="eyebrow">Ready?</span><h2>Ready to modernize your school?</h2><p>Book a School Pulse demo and see how the platform can fit your school.</p><div class="cta-row" style="justify-content:center"><a class="btn btn-primary" href="/demo">Book Demo</a><a class="btn btn-secondary" href="/pricing">View Pricing</a></div></div></section>
</BaseLayout>
