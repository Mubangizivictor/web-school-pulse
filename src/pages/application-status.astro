---
import '../styles/auth.css';
import '../styles/branding.css';
import BrandLogo from '../components/BrandLogo.astro';
import faviconUrl from '../../favicon.png?url';
import iconLightUrl from '../../icon_light_Mode.png?url';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <meta name="robots" content="noindex"/>
  <meta name="theme-color" content="#eef3f9"/>
  <link rel="icon" type="image/png" href={faviconUrl}/>
  <link rel="apple-touch-icon" href={iconLightUrl}/>
  <link rel="manifest" href="/manifest.webmanifest"/>
  <title>Application Status — School Pulse</title>
</head>
<body>
  <main class="status-page">
    <section class="status-card">
      <a class="auth-brand brand-image-link" href="/" aria-label="School Pulse home" style="justify-content:center!important"><BrandLogo kind="logo" mode="light" class="auth-brand-logo" /></a>
      <div class="status-icon" id="statusIcon">◷</div>
      <span class="status-badge" id="statusBadge">Under Review</span>
      <h1 id="statusTitle">Your application is pending review</h1>
      <div class="status-school" id="schoolName">Your school</div>
      <p id="statusCopy">Your institution registration has been received and is currently being reviewed by Victorbee Technologies.</p>

      <div id="reviewNote" hidden style="margin:18px 0;padding:14px 16px;border-radius:12px;background:#fff4f2;color:#9f2d20;text-align:left"></div>

      <div style="margin:24px 0;text-align:left">
        <div style="display:flex;gap:12px;align-items:flex-start;margin-bottom:14px"><span id="stepSubmitted" style="font-weight:800;color:#159455">✓</span><div><strong>Application submitted</strong><div style="color:#718096;font-size:13px">Your registration is safely stored in School Pulse.</div></div></div>
        <div style="display:flex;gap:12px;align-items:flex-start;margin-bottom:14px"><span id="stepReview" style="font-weight:800;color:#b7791f">◷</span><div><strong>Owner review</strong><div id="reviewStepCopy" style="color:#718096;font-size:13px">Waiting for Victorbee Technologies to review the school.</div></div></div>
        <div style="display:flex;gap:12px;align-items:flex-start"><span id="stepActivation" style="font-weight:800;color:#94a3b8">○</span><div><strong>School activation</strong><div id="activationStepCopy" style="color:#718096;font-size:13px">After approval, your School Admin account is linked to the live school workspace.</div></div></div>
      </div>

      <div id="statusMessage" hidden style="margin:12px 0;font-size:13px;color:#68778d"></div>
      <button class="auth-btn auth-btn-primary" id="checkStatus" type="button" style="width:100%">↻ Check Status</button>
      <a class="auth-btn auth-btn-success" id="openApp" href="#" style="width:100%;margin-top:10px;display:none">Open School Pulse →</a>
      <div style="border-top:1px solid #e7ebf1;margin:22px 0"></div>
      <a class="auth-btn auth-btn-outline" href="/login" style="width:100%">← Back to Sign In</a>
      <div class="auth-footer">Powered by Victorbee Technologies © 2026</div>
    </section>
  </main>

  <script type="module" is:inline>
    import { auth, functionsBaseUrl, appUrl } from '/js/firebase-client.js';
    import { onAuthStateChanged } from 'https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js';

    const q=new URLSearchParams(location.search);
    const schoolEl=document.getElementById('schoolName');
    const badgeEl=document.getElementById('statusBadge');
    const titleEl=document.getElementById('statusTitle');
    const copyEl=document.getElementById('statusCopy');
    const iconEl=document.getElementById('statusIcon');
    const noteEl=document.getElementById('reviewNote');
    const checkButton=document.getElementById('checkStatus');
    const openApp=document.getElementById('openApp');
    const statusMessage=document.getElementById('statusMessage');
    const reviewStepCopy=document.getElementById('reviewStepCopy');
    const activationStepCopy=document.getElementById('activationStepCopy');
    const stepReview=document.getElementById('stepReview');
    const stepActivation=document.getElementById('stepActivation');

    let currentUser=null;
    let checking=false;

    function render(result={}){
      const status=result.status||q.get('status')||'pending_review';
      const school=result.schoolName||q.get('school')||'Your school';
      schoolEl.textContent=school;
      noteEl.hidden=true;
      openApp.style.display='none';

      if(status==='approved'){
        badgeEl.textContent='Approved';
        titleEl.textContent='Your school is approved';
        copyEl.textContent=result.appReady?'Your School Pulse workspace is ready. You can now continue with the same administrator email and password you used during registration.':'Your application is approved. We are finishing the school workspace activation.';
        iconEl.textContent='✓';
        stepReview.textContent='✓'; stepReview.style.color='#159455';
        reviewStepCopy.textContent='Application approved by the School Pulse platform owner.';
        stepActivation.textContent=result.appReady?'✓':'◷'; stepActivation.style.color=result.appReady?'#159455':'#b7791f';
        activationStepCopy.textContent=result.appReady?'Your school tenant and first School Admin account are active.':'Workspace activation is being finalized.';
        if(result.appReady){openApp.href=result.appUrl||appUrl;openApp.style.display='flex'}
        return;
      }
      if(status==='rejected'){
        badgeEl.textContent='Needs Attention';
        titleEl.textContent='Your application needs attention';
        copyEl.textContent='This application was not approved. Review the reason below, then contact School Pulse support if you need help.';
        iconEl.textContent='!';
        stepReview.textContent='!'; stepReview.style.color='#c24132';
        reviewStepCopy.textContent='The platform owner could not approve the current application.';
        stepActivation.textContent='○'; stepActivation.style.color='#94a3b8';
        if(result.rejectionReason){noteEl.textContent=`Review note: ${result.rejectionReason}`;noteEl.hidden=false}
        return;
      }
      if(status==='email_verified'||status==='email_verification_pending'){
        badgeEl.textContent='Registration Incomplete';
        titleEl.textContent='Finish your school application';
        copyEl.textContent='Your account exists, but the registration must be completed before it can be reviewed.';
        iconEl.textContent='…';
        stepReview.textContent='○'; stepReview.style.color='#94a3b8';
        return;
      }
      badgeEl.textContent='Under Review';
      titleEl.textContent='Your application is pending review';
      copyEl.textContent='Your institution registration has been received and is currently being reviewed by Victorbee Technologies. You can leave this page and return later.';
      iconEl.textContent='◷';
      stepReview.textContent='◷'; stepReview.style.color='#b7791f';
      reviewStepCopy.textContent='Waiting for Victorbee Technologies to review the school.';
      stepActivation.textContent='○'; stepActivation.style.color='#94a3b8';
    }

    async function checkStatus(silent=false){
      if(checking)return;
      if(!currentUser){
        if(!silent){statusMessage.textContent='Sign in with the administrator account to refresh this status.';statusMessage.hidden=false}
        return;
      }
      checking=true;
      if(!silent){checkButton.disabled=true;checkButton.textContent='Checking…';statusMessage.hidden=true}
      try{
        const token=await currentUser.getIdToken(true);
        const response=await fetch(`${functionsBaseUrl}/getSchoolApplicationStatus`,{headers:{Authorization:`Bearer ${token}`}});
        const result=await response.json().catch(()=>({}));
        if(response.status===404){location.href='/register?verified=1';return}
        if(!response.ok)throw new Error(result.message||result.error||'Could not refresh application status.');
        render(result);
        if(!silent){statusMessage.textContent='Status updated just now.';statusMessage.hidden=false}
      }catch(error){
        if(!silent){statusMessage.textContent=error?.message||'Could not refresh application status.';statusMessage.hidden=false}
      }finally{
        checking=false;
        if(!silent){checkButton.disabled=false;checkButton.textContent='↻ Check Status'}
      }
    }

    checkButton.addEventListener('click',()=>checkStatus(false));
    render();
    onAuthStateChanged(auth,user=>{currentUser=user;if(user)checkStatus(true)});
    setInterval(()=>{if(currentUser)checkStatus(true)},30000);
  </script>
</body></html>
