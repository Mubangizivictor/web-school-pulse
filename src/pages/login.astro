---
import AuthLayout from '../layouts/AuthLayout.astro';
---
<AuthLayout title="Sign In — School Pulse">
  <div class="auth-panel login-panel">
    <div class="auth-brand"><span class="auth-brand-mark">SP</span><div><strong>School Pulse</strong><small>School Management System</small></div></div>
    <a class="auth-back" href="/">← Back to School Pulse home</a>
    <h1 class="auth-title">Welcome back</h1>
    <p class="auth-subtitle">Sign in to your School Pulse account to continue.</p>
    <div id="loginMessage" hidden></div>
    <form class="login-form" id="loginForm">
      <div class="form-field"><label>Email</label><input id="loginEmail" type="email" autocomplete="email" required placeholder="you@example.com" /></div>
      <div class="form-field"><label>Password</label><div class="password-wrap"><input id="loginPassword" type="password" autocomplete="current-password" required /><button class="password-toggle" type="button" id="togglePassword" aria-label="Show password">◉</button></div></div>
      <button class="auth-btn auth-btn-primary login-submit" id="loginButton" type="submit">→ Sign In</button>
    </form>
    <div class="auth-links"><button id="forgotPassword" type="button" style="border:0;background:none;color:#68778d;cursor:pointer">Forgot your password?</button></div>
    <div class="auth-links">New to School Pulse? <a href="/register">Register Your School</a></div>
    <div class="auth-footer">Powered by Victorbee Technologies © 2026</div>
  </div>

  <script type="module" is:inline>
    import { auth, functionsBaseUrl, appUrl } from '/js/firebase-client.js';
    import { signInWithEmailAndPassword, sendPasswordResetEmail, sendEmailVerification, signOut } from 'https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js';
    const msg=document.getElementById('loginMessage');
    const setMessage=(text,type='error')=>{msg.hidden=!text;msg.className=type==='success'?'auth-success':type==='info'?'auth-info':'auth-error';msg.textContent=text||''};
    const button=document.getElementById('loginButton');
    document.getElementById('togglePassword').addEventListener('click',()=>{const el=document.getElementById('loginPassword');el.type=el.type==='password'?'text':'password'});
    document.getElementById('loginForm').addEventListener('submit',async e=>{
      e.preventDefault();setMessage('');button.disabled=true;button.innerHTML='<span class="loading"></span> Signing in…';
      try{
        const email=document.getElementById('loginEmail').value.trim();const password=document.getElementById('loginPassword').value;
        const cred=await signInWithEmailAndPassword(auth,email,password);const user=cred.user;
        if(!user.emailVerified){await sendEmailVerification(user,{url:'https://schoolpulse.victorbee.com/register?verified=1',handleCodeInApp:false}).catch(()=>{});setMessage('Your email is not verified yet. We sent another verification email.','info');button.disabled=false;button.textContent='→ Sign In';return}
        const token=await user.getIdToken(true);
        const response=await fetch(`${functionsBaseUrl}/getSchoolApplicationStatus`,{headers:{'Authorization':`Bearer ${token}`}});
        const result=await response.json().catch(()=>({}));
        if(response.status===404){setMessage('This account does not have a school registration application yet. Register your school first.','info');button.disabled=false;button.textContent='→ Sign In';return}
        if(!response.ok)throw new Error(result.message||result.error||'Could not check account status.');
        if(result.status==='pending_review'||result.status==='pending'){location.href=`/application-status?status=pending&school=${encodeURIComponent(result.schoolName||'Your school')}`;return}
        if(result.status==='rejected'){location.href=`/application-status?status=rejected&school=${encodeURIComponent(result.schoolName||'Your school')}`;return}
        if(result.status==='approved'){
          if(result.appReady){location.href=result.appUrl||appUrl;return}
          location.href=`/application-status?status=approved&school=${encodeURIComponent(result.schoolName||'Your school')}`;return
        }
        location.href=`/application-status?status=${encodeURIComponent(result.status||'pending')}&school=${encodeURIComponent(result.schoolName||'Your school')}`;
      }catch(err){
        const code=err?.code||'';const friendly=(code==='auth/invalid-credential'||code==='auth/wrong-password'||code==='auth/user-not-found')?'Incorrect email or password.':code==='auth/too-many-requests'?'Too many attempts. Please wait and try again.':code==='auth/unauthorized-domain'?'schoolpulse.victorbee.com must be added to Firebase Authentication authorized domains.':(err?.message||'Sign in failed.');setMessage(friendly);button.disabled=false;button.textContent='→ Sign In'
      }
    });
    document.getElementById('forgotPassword').addEventListener('click',async()=>{const email=document.getElementById('loginEmail').value.trim();if(!email){setMessage('Enter your email address first, then choose Forgot your password?','info');return}try{await sendPasswordResetEmail(auth,email,{url:'https://schoolpulse.victorbee.com/login'});setMessage('Password reset email sent. Check your inbox.','success')}catch(err){setMessage(err?.message||'Could not send password reset email.')}});
  </script>
</AuthLayout>
