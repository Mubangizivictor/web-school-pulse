---
import '../styles/auth.css';
const { title = 'School Pulse', asideTitle = 'Everything your school needs, in one place.', asideCopy = 'School Pulse connects every part of school administration — from enrolment to graduation — into one practical platform.' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>{title}</title>
</head>
<body>
  <div class="auth-shell">
    <aside class="auth-aside">
      <div class="auth-aside-inner">
        <h1>{asideTitle}</h1>
        <p>{asideCopy}</p>
        <div class="auth-benefits">
          <div class="auth-benefit"><i>✓</i><span>Set up in a few guided steps</span></div>
          <div class="auth-benefit"><i>✓</i><span>Secure Firebase authentication</span></div>
          <div class="auth-benefit"><i>✓</i><span>Student, finance & academic tools</span></div>
          <div class="auth-benefit"><i>✓</i><span>Uganda-focused onboarding support</span></div>
        </div>
      </div>
    </aside>
    <main class="auth-main"><slot /></main>
  </div>
</body>
</html>
