---
import AuthLayout from '../layouts/AuthLayout.astro';
import BrandLogo from '../components/BrandLogo.astro';
---
<AuthLayout title="Register Your School — School Pulse">
  <div class="auth-panel" id="registrationApp">
    <a class="auth-brand-clean" href="/" aria-label="School Pulse home"><BrandLogo kind="icon" mode="light" class="auth-brand-clean-icon" /><span><strong>School Pulse</strong><small>School Management System</small></span></a>
    <a class="auth-back" href="/login">← Back to Sign In</a>
    <h1 class="auth-title">Create your school account</h1>
    <p class="auth-subtitle">Get your school application ready in a few guided steps.</p>
    <div class="steps" aria-label="Registration progress">
      {['School','Location','Plan','User','Verify','Terms'].map((s,i)=><div class:list={['step',i===0&&'active']} data-step-indicator={i}><div class="step-dot">{i+1}</div><span>{s}</span></div>)}
    </div>
    <div id="globalMessage" hidden></div>

    <section class="step-section active" data-step="0">
      <h2 class="section-title">School Details</h2><p class="section-copy">Tell us about your institution.</p>
      <div class="form-grid">
        <div class="form-field"><label>School Name *</label><input id="schoolName" placeholder="e.g. Sunrise High School" /></div>
        <div class="form-field"><label>Short Name</label><input id="shortName" placeholder="e.g. SHS" /></div>
        <div class="form-field"><label>School Email *</label><input id="schoolEmail" type="email" placeholder="school@example.com" /></div>
        <div class="form-field"><label>Phone Number *</label><div class="input-prefix"><span>+256</span><input id="schoolPhone" inputmode="tel" placeholder="7XXXXXXXX" maxlength="9" /></div></div>
        <div class="form-field"><label>School Category *</label><select id="schoolCategory"><option value="">Select category</option><option>Private</option><option>Government / Public</option><option>International</option><option>Faith-based</option><option>NGO / Community</option><option>Other</option></select></div>
        <div class="form-field"><label>P.O. Box</label><input id="poBox" /></div>
        <div class="form-field"><label>School Prefix / Initials *</label><input id="schoolPrefix" placeholder="e.g. SHS" maxlength="12" /></div>
        <div class="form-field"><label>Tagline / Motto</label><input id="motto" /></div>
      </div><div class="form-actions right"><button class="auth-btn auth-btn-primary" data-next>Next →</button></div>
    </section>

    <section class="step-section" data-step="1">
      <h2 class="section-title">Location Details</h2><p class="section-copy">Where your school is located.</p>
      <div class="form-grid">
        <div class="form-field"><label>Region *</label><select id="region"><option value="">Select region</option><option>Central</option><option>Eastern</option><option>Northern</option><option>Western</option></select></div>
        <div class="form-field"><label>District *</label><input id="district" /></div>
        <div class="form-field"><label>Physical Address *</label><input id="address" /></div>
        <div class="form-field"><label>Website</label><input id="schoolWebsite" type="url" /></div>
        <div class="form-field"><label>Location Name</label><input id="locationName" /></div>
        <div class="form-field"><label>Latitude</label><input id="latitude" /></div>
        <div class="form-field"><label>Longitude</label><input id="longitude" /></div>
      </div><div class="form-actions"><button class="auth-btn auth-btn-outline" data-back>← Back</button><button class="auth-btn auth-btn-primary" data-next>Next →</button></div>
    </section>

    <section class="step-section" data-step="2">
      <h2 class="section-title">School Pulse & Plan</h2><p class="section-copy">Choose your plan and the optional modules your school needs.</p>
      <div class="form-field full"><label>Application</label><input value="School Pulse — Complete School Management Platform" disabled /></div>
      <div class="form-field full" style="margin-top:18px"><label>Plan *</label><div class="choice-row">
        {['Starter','Growth','Pro','Enterprise'].map((p,i)=><div class="choice"><input type="radio" id={`plan${p}`} name="plan" value={p} checked={i===0}/><label for={`plan${p}`}>{p}</label></div>)}
      </div></div>
      <div class="form-field full" style="margin-top:20px"><label>Modules</label><span class="hint">Green modules are included by default. Click optional modules to add or remove them.</span>
        <div class="module-row" id="moduleChooser" style="margin-top:10px">
          {['Students','Attendance','Academics','Administration'].map(m=><button type="button" class="module-chip included locked" data-module={m} aria-pressed="true">✓ {m}</button>)}
          {['Finance','Boarding','Health','Library','Transport','Messaging'].map(m=><button type="button" class="module-chip selectable" data-module={m} aria-pressed="false">+ {m}</button>)}
        </div>
        <span class="hint" id="moduleSummary">4 core modules selected.</span>
      </div>
      <div class="form-actions"><button class="auth-btn auth-btn-outline" data-back>← Back</button><button class="auth-btn auth-btn-primary" data-next>Next →</button></div>
    </section>

    <section class="step-section" data-step="3">
      <h2 class="section-title">Administrator Details</h2><p class="section-copy">This account will represent the school during onboarding.</p>
      <div class="form-grid">
        <div class="form-field"><label>First Name *</label><input id="firstName" /></div><div class="form-field"><label>Last Name *</label><input id="lastName" /></div>
        <div class="form-field"><label>Gender</label><select id="gender"><option value="">Select gender</option><option>Male</option><option>Female</option><option>Prefer not to say</option></select></div>
        <div class="form-field"><label>Phone Number *</label><div class="input-prefix"><span>+256</span><input id="adminPhone" inputmode="tel" maxlength="9" /></div></div>
        <div class="form-field full"><label>Email *</label><input id="adminEmail" type="email" /></div><div class="form-field full"><label>Username</label><input id="username" disabled /></div>
        <div class="form-field"><label>Password *</label><input id="password" type="password" placeholder="Min. 8 chars, upper, lower, digit & symbol" /></div><div class="form-field"><label>Confirm Password *</label><input id="confirmPassword" type="password" /></div>
      </div><div class="form-actions"><button class="auth-btn auth-btn-outline" data-back>← Back</button><button class="auth-btn auth-btn-primary" id="createAccountBtn">Create & Verify Email →</button></div>
    </section>

    <section class="step-section" data-step="4">
      <h2 class="section-title">Verify Your Email</h2><p class="section-copy">Confirm your email to secure this registration.</p>
      <div class="verify-box"><div class="verify-icon">✉</div><h3>Check your email</h3><div class="verify-email" id="verifyEmailText">—</div><p class="verify-state" id="verifyState">Open the School Pulse verification email and click Verify Email.</p>
        <div class="choice-row" style="justify-content:center;margin-top:18px"><button class="auth-btn auth-btn-outline" id="resendVerification">Resend Email</button><button class="auth-btn auth-btn-primary" id="checkVerification">Check Verification</button></div>
      </div><div class="form-actions"><button class="auth-btn auth-btn-outline" data-back>← Back</button><button class="auth-btn auth-btn-primary" id="continueAfterVerify" disabled>Continue to Terms →</button></div>
    </section>

    <section class="step-section" data-step="5">
      <h2 class="section-title">Terms & Conditions</h2><p class="section-copy">One final step before your application goes into review.</p>
      <div class="terms-box"><h4>Terms of Service</h4><p>By registering for School Pulse, you confirm that you are authorised to submit this application for the institution and that the information is accurate. Activation and subscription access remain subject to approval by Victorbee Technologies.</p><h4>Privacy</h4><p>Registration information is processed for onboarding, security, support and service delivery.</p></div>
      <label class="check-row"><input id="acceptTerms" type="checkbox" /> <span>I agree to the <a href="/terms" target="_blank">Terms of Service</a> and <a href="/privacy" target="_blank">Privacy Policy</a>.</span></label>
      <label class="check-row"><input id="marketingOptIn" type="checkbox" /> <span>Send me School Pulse product and onboarding updates (optional).</span></label>
      <div class="form-actions"><button class="auth-btn auth-btn-outline" data-back>← Back</button><button class="auth-btn auth-btn-success" id="submitApplication">✓ Submit Application</button></div>
    </section>
    <div class="auth-links">Already have an account? <a href="/login">Sign In</a></div><div class="auth-footer">Powered by Victorbee Technologies © 2026</div>
  </div>

  <script type="module" is:inline>
    import { auth, functionsBaseUrl } from '/js/firebase-client.js';
    import { createUserWithEmailAndPassword, sendEmailVerification, updateProfile, reload } from 'https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js';
    let currentStep=0; const requiredModules=['Students','Attendance','Academics','Administration']; const optionalModules=new Set();
    const sections=[...document.querySelectorAll('[data-step]')], indicators=[...document.querySelectorAll('[data-step-indicator]')], message=document.getElementById('globalMessage');
    const byId=id=>document.getElementById(id), value=id=>(byId(id)?.value||'').trim();
    const selectedModules=()=>[...requiredModules,...optionalModules];
    const setMessage=(t,type='error')=>{message.hidden=!t;message.className=type==='success'?'auth-success':type==='info'?'auth-info':'auth-error';message.textContent=t||''};
    const normalizePhone=v=>/^7\d{8}$/.test(v.replace(/\D/g,''))?`256${v.replace(/\D/g,'')}`:null;
    const validEmail=v=>/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v); const strong=v=>v.length>=8&&/[A-Z]/.test(v)&&/[a-z]/.test(v)&&/\d/.test(v)&&/[^A-Za-z0-9]/.test(v);
    const showStep=i=>{currentStep=Math.max(0,Math.min(5,i));sections.forEach((s,n)=>s.classList.toggle('active',n===currentStep));indicators.forEach((s,n)=>{s.classList.toggle('active',n===currentStep);s.classList.toggle('done',n<currentStep);const d=s.querySelector('.step-dot');if(d)d.textContent=n<currentStep?'✓':String(n+1)});setMessage('');saveDraft();scrollTo({top:0,behavior:'smooth'})};
    function validate(i){if(i===0&&(!value('schoolName')||!validEmail(value('schoolEmail'))||!normalizePhone(value('schoolPhone'))||!value('schoolCategory')||!value('schoolPrefix')))return'Complete all required school details.';if(i===1&&(!value('region')||!value('district')||!value('address')))return'Complete the required location details.';if(i===3){if(!value('firstName')||!value('lastName')||!normalizePhone(value('adminPhone'))||!validEmail(value('adminEmail')))return'Complete the administrator details.';if(!strong(value('password')))return'Password needs 8+ characters with uppercase, lowercase, number and symbol.';if(value('password')!==value('confirmPassword'))return'Passwords do not match.'}return null}
    document.querySelectorAll('[data-next]').forEach(b=>b.addEventListener('click',()=>{const e=validate(currentStep);e?setMessage(e):showStep(currentStep+1)}));document.querySelectorAll('[data-back]').forEach(b=>b.addEventListener('click',()=>showStep(currentStep-1)));
    byId('adminEmail').addEventListener('input',e=>byId('username').value=e.target.value.split('@')[0].replace(/[^a-zA-Z0-9._]/g,'').toLowerCase()); byId('schoolPrefix').addEventListener('input',e=>e.target.value=e.target.value.toUpperCase().replace(/[^A-Z0-9]/g,''));
    document.querySelectorAll('.module-chip.selectable').forEach(b=>b.addEventListener('click',()=>{const m=b.dataset.module;if(optionalModules.has(m)){optionalModules.delete(m);b.classList.remove('included');b.setAttribute('aria-pressed','false');b.textContent=`+ ${m}`}else{optionalModules.add(m);b.classList.add('included');b.setAttribute('aria-pressed','true');b.textContent=`✓ ${m}`}byId('moduleSummary').textContent=`${selectedModules().length} modules selected.`;saveDraft()}));
    function payload(){return{school:{name:value('schoolName'),shortName:value('shortName'),email:value('schoolEmail'),phone:normalizePhone(value('schoolPhone')),category:value('schoolCategory'),poBox:value('poBox'),prefix:value('schoolPrefix'),motto:value('motto')},location:{region:value('region'),district:value('district'),address:value('address'),website:value('schoolWebsite'),locationName:value('locationName'),latitude:value('latitude'),longitude:value('longitude')},plan:document.querySelector('input[name="plan"]:checked')?.value||'Starter',selectedModules:selectedModules(),administrator:{firstName:value('firstName'),lastName:value('lastName'),gender:value('gender'),phone:normalizePhone(value('adminPhone')),email:value('adminEmail'),username:value('username')},marketingOptIn:byId('marketingOptIn').checked,termsAccepted:true}}
    function saveDraft(){const ids=['schoolName','shortName','schoolEmail','schoolPhone','schoolCategory','poBox','schoolPrefix','motto','region','district','address','schoolWebsite','locationName','latitude','longitude','firstName','lastName','gender','adminPhone','adminEmail'];const d={step:currentStep,plan:document.querySelector('input[name="plan"]:checked')?.value||'Starter',modules:[...optionalModules]};ids.forEach(id=>d[id]=value(id));localStorage.setItem('schoolPulseRegistrationDraft',JSON.stringify(d))}
    try{const d=JSON.parse(localStorage.getItem('schoolPulseRegistrationDraft')||'{}');Object.entries(d).forEach(([k,v])=>{const el=byId(k);if(el&&!el.value&&typeof v==='string')el.value=v});(d.modules||[]).forEach(m=>{optionalModules.add(m);const b=document.querySelector(`[data-module="${m}"]`);if(b){b.classList.add('included');b.setAttribute('aria-pressed','true');b.textContent=`✓ ${m}`}});if(d.plan){const r=document.querySelector(`input[name="plan"][value="${d.plan}"]`);if(r)r.checked=true}if(byId('adminEmail').value)byId('username').value=byId('adminEmail').value.split('@')[0].toLowerCase();byId('moduleSummary').textContent=`${selectedModules().length} modules selected.`}catch{}
    async function saveServerDraft(user){try{const token=await user.getIdToken(true);await fetch(`${functionsBaseUrl}/saveSchoolRegistrationDraft`,{method:'POST',headers:{'Content-Type':'application/json','Authorization':`Bearer ${token}`},body:JSON.stringify(payload())})}catch(e){console.warn('Draft persistence pending backend deploy',e)}}
    byId('createAccountBtn').addEventListener('click',async()=>{const e=validate(3);if(e){setMessage(e);return}const btn=byId('createAccountBtn');btn.disabled=true;btn.innerHTML='<span class="loading"></span> Creating account…';try{let user=auth.currentUser;if(!user){const c=await createUserWithEmailAndPassword(auth,value('adminEmail'),value('password'));user=c.user;await updateProfile(user,{displayName:`${value('firstName')} ${value('lastName')}`})}await saveServerDraft(user);byId('verifyEmailText').textContent=user.email;if(!user.emailVerified)await sendEmailVerification(user,{url:'https://schoolpulse.victorbee.com/register?verified=1',handleCodeInApp:false});showStep(4);setMessage('Verification email sent. Check Inbox and Spam.','info')}catch(err){setMessage(err?.code==='auth/email-already-in-use'?'An account already exists with this email. Sign in or use another email.':(err?.message||'Could not create the account.'))}finally{btn.disabled=false;btn.textContent='Create & Verify Email →'}});
    async function checkVerification(){const user=auth.currentUser;if(!user){setMessage('Sign in again to continue this registration.','info');return false}await reload(user);if(user.emailVerified){byId('continueAfterVerify').disabled=false;byId('verifyState').textContent='Email verified successfully. Continue to the Terms & Conditions step.';await saveServerDraft(user);setMessage('Email verified successfully.','success');return true}setMessage('Email is not verified yet. Open the verification email and click Verify Email.','info');return false}
    byId('checkVerification').addEventListener('click',checkVerification);byId('resendVerification').addEventListener('click',async()=>{try{await sendEmailVerification(auth.currentUser,{url:'https://schoolpulse.victorbee.com/register?verified=1',handleCodeInApp:false});setMessage('Verification email sent again.','success')}catch(e){setMessage(e?.message||'Could not resend verification email.')}});byId('continueAfterVerify').addEventListener('click',async()=>{if(await checkVerification())showStep(5)});
    byId('submitApplication').addEventListener('click',async()=>{if(!byId('acceptTerms').checked){setMessage('Accept the Terms of Service and Privacy Policy to continue.');return}if(!(await checkVerification())){showStep(4);return}const btn=byId('submitApplication');btn.disabled=true;btn.innerHTML='<span class="loading"></span> Submitting…';try{const token=await auth.currentUser.getIdToken(true);const body=payload();body.termsAccepted=true;const r=await fetch(`${functionsBaseUrl}/submitSchoolApplication`,{method:'POST',headers:{'Content-Type':'application/json','Authorization':`Bearer ${token}`},body:JSON.stringify(body)});const x=await r.json().catch(()=>({}));if(!r.ok)throw new Error(x.message||x.error||'Application submission failed.');localStorage.removeItem('schoolPulseRegistrationDraft');location.href=`/application-status?status=pending&school=${encodeURIComponent(value('schoolName'))}`}catch(e){setMessage(e?.message||'Could not submit application.');btn.disabled=false;btn.textContent='✓ Submit Application'}});
    const params=new URLSearchParams(location.search);if(params.get('verified')==='1'){showStep(4);setTimeout(async()=>{if(await checkVerification())setTimeout(()=>showStep(5),900)},500)}
  </script>
</AuthLayout>
